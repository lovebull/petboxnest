# Petboxnest Medusa Backend domain deployment template.
# Copy this file to apps/backend/.env on a new server, then fill secrets.

PORT=8030
NODE_ENV=production

# Public domains. Do not use the server IP in production.
STORE_CORS=https://www.Petboxnest.com
ADMIN_CORS=https://api.Petboxnest.com
AUTH_CORS=https://www.Petboxnest.com,https://api.Petboxnest.com

# Public URLs generated by Medusa and Admin.
MEDUSA_BACKEND_URL=https://api.Petboxnest.com
MEDUSA_STOREFRONT_URL=https://www.Petboxnest.com
MEDUSA_FILE_BACKEND_URL=https://api.Petboxnest.com/static

# SeaweedFS S3-compatible media storage.
S3_FILE_URL=https://media.youmain.com
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1
S3_BUCKET=replace-with-seaweedfs-bucket-name
S3_ENDPOINT=https://s3.youmain.com
S3_PREFIX=

# Internal service URLs used by backend-to-server calls.
STOREFRONT_URL=http://127.0.0.1:8010
STOREFRONT_REVALIDATE_URL=http://127.0.0.1:8010/api/revalidate

# Infrastructure. Replace credentials on the new server.
DATABASE_URL=postgres://postgres:replace-with-password@127.0.0.1:5432/Petboxnest
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/0
DB_NAME=Petboxnest

# Required secrets. Replace before starting production.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-another-long-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-32-byte-hex-secret
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret

# Feature flags and optional services.
MEDUSA_FF_CACHING=true
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=/www/wwwroot/Petboxnest/apps/storefront
RESEND_FROM_EMAIL=
RESEND_API_KEY=
