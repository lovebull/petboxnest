# petboxnest Payload CMS domain deployment template.
# Copy this file to apps/cms/.env.local on a new server, then fill secrets.

NODE_ENV=production
PORT=8020

# Public CMS domain.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.petboxnest.com

# Public cross-system browser URLs.
NEXT_PUBLIC_BASE_URL=https://www.petboxnest.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.petboxnest.com

# Internal server-to-server URLs.
MEDUSA_BACKEND_URL=http://127.0.0.1:8030

# Storefront cache revalidation webhook used by article hooks.
STOREFRONT_REVALIDATE_URL=http://127.0.0.1:8010/api/revalidate
REVALIDATE_SECRET=replace-with-the-same-secret-as-storefront

# Infrastructure. Replace credentials on the new server.
DATABASE_URL=postgres://postgres:replace-with-password@127.0.0.1:5432/petboxnest_cms

# Required secrets. Replace before starting production.
PAYLOAD_SECRET=replace-with-a-long-random-payload-secret

# Medusa publishable key used by CMS product selector.
MEDUSA_PUBLISHABLE_API_KEY=replace-with-medusa-publishable-api-key

# SeaweedFS S3-compatible media storage.
PAYLOAD_S3_PUBLIC_URL=https://media.youmain.com
PAYLOAD_S3_ENDPOINT=https://s3.youmain.com
PAYLOAD_S3_REGION=us-east-1
PAYLOAD_S3_BUCKET=replace-with-seaweedfs-bucket-name
PAYLOAD_S3_ACCESS_KEY_ID=replace-with-s3-access-key
PAYLOAD_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
