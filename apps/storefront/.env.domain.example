# petboxnest Storefront domain deployment template.
# Copy this file to apps/storefront/.env.local on a new server, then fill keys.

NODE_ENV=production
PORT=7000

# Public browser URLs.
NEXT_PUBLIC_BASE_URL=https://www.petboxnest.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.petboxnest.com
NEXT_PUBLIC_PAYLOAD_SERVER_URL=https://cms.petboxnest.com

# Internal server-to-server URLs.
MEDUSA_BACKEND_URL=http://127.0.0.1:8030
PAYLOAD_SERVER_URL=http://127.0.0.1:8020

# Storefront settings.
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-medusa-publishable-api-key
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret

# Optional payment / storage settings.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
