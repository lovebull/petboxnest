# Medusa 后台生成的 Publishable API Key。
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
PUBLIC_PROTOCOL=http
PUBLIC_HOST=127.0.0.1
NEXT_PUBLIC_PUBLIC_PROTOCOL=$PUBLIC_PROTOCOL
NEXT_PUBLIC_PUBLIC_HOST=$PUBLIC_HOST

# Medusa API 地址。
NEXT_PUBLIC_MEDUSA_BACKEND_URL=$NEXT_PUBLIC_PUBLIC_PROTOCOL://$NEXT_PUBLIC_PUBLIC_HOST:8030
MEDUSA_BACKEND_URL=http://127.0.0.1:8030

# Larumsport 首发市场为美国。
NEXT_PUBLIC_DEFAULT_REGION=us

# Storefront 对外地址。
NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_PUBLIC_PROTOCOL://$NEXT_PUBLIC_PUBLIC_HOST:8010

# 启用 Stripe 时填写 Publishable Key。
NEXT_PUBLIC_STRIPE_KEY=

# 仅 Medusa Cloud S3 部署需要。
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development

# Payload CMS 地址，仅用于读取产品增强内容。
NEXT_PUBLIC_PAYLOAD_SERVER_URL=$NEXT_PUBLIC_PUBLIC_PROTOCOL://$NEXT_PUBLIC_PUBLIC_HOST:8020
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret
